{
  "name": "alpine-desktop-center-web",
  "version": "0.1.0-alpha.47-web",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11.25.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "check": "tsc -b --pretty false",
    "test:bridge": "python3 -m unittest discover -s tests -v",
    "test": "pnpm test:bridge"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
