[Desktop Entry]
Name=Alpine Desktop Center
Comment=Open Alpine Desktop Center in its own full-screen local app window
Exec=/bin/sh -c "exec \\"$(dirname \\"$1\\")/launch-from-desktop.sh\\" \\"$1\\"" dummy %k
Terminal=false
Type=Application
Categories=Settings;System;
Icon=alpine-desktop-center
StartupNotify=true
StartupWMClass=AlpineDesktopCenter
X-GNOME-SingleWindow=true
X-KDE-SubstituteUID=false
