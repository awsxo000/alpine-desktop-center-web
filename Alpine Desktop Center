#!/bin/sh
set -eu
APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHON=${ALPINE_DESKTOP_CENTER_PYTHON:-python3}
STATE_DIR="$APP_DIR/.alpine-state/web"
LOG_FILE="$STATE_DIR/server.log"
PID_FILE="$STATE_DIR/server.pid"

if ! command -v "$PYTHON" >/dev/null 2>&1; then
  TERMINAL=$(command -v konsole || command -v xterm || command -v alacritty || command -v kitty || command -v foot || command -v xfce4-terminal || true)
  if [ -z "$TERMINAL" ]; then
    printf '%s\n' 'Python 3 is required. Install it, then run Alpine Desktop Center again.' >&2
    exit 1
  fi
  exec "$TERMINAL" -e sh -c "cd '$APP_DIR/backend' && printf '%s\\n' 'Alpine Desktop Center needs Python 3 before it can start.' 'The backend installer will prepare Python, Ansible, make and doas.' 'The password, if requested by doas, is typed only in this terminal and is not stored by the application.'; sh instalar.sh; status=\$?; if [ \"\$status\" -ne 0 ]; then printf '\\nSetup failed with exit code %s. Press Enter to close...' \"\$status\"; read -r _; fi; exit \"\$status\""
fi

needs_setup=0
missing_dependencies=""
for dependency in make ansible-playbook doas; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    needs_setup=1
    missing_dependencies="$missing_dependencies $dependency"
  fi
done
if [ "$needs_setup" -eq 1 ]; then
  TERMINAL=$(command -v konsole || command -v xterm || command -v alacritty || command -v kitty || command -v foot || command -v xfce4-terminal || true)
  if [ -z "$TERMINAL" ]; then
    printf '%s\n' "Missing backend dependencies:$missing_dependencies" 'Install a supported terminal emulator and run Alpine Desktop Center again.' >&2
    exit 1
  fi
  printf '%s\n' "Missing backend dependencies:$missing_dependencies" 'Opening a terminal to prepare the Alpine Desktop Center backend.'
  "$TERMINAL" -e sh -c "cd '$APP_DIR/backend' && printf '%s\\n' 'Alpine Desktop Center dependency setup' 'The installer will explain each step and may install make, Python 3, Ansible, doas and the required Ansible collection.' 'The installer does not collect or store your password.' 'This terminal closes automatically after a successful setup.'; printf '\\n'; sh instalar.sh; status=\$?; if [ \"\$status\" -ne 0 ]; then printf '\\nSetup failed with exit code %s. Press Enter to continue...' \"\$status\"; read -r _; fi; exit \"\$status\""
  if [ "$?" -ne 0 ]; then
    printf '%s\n' 'Dependency setup failed. Check the terminal output and run Alpine Desktop Center again.' >&2
    exit 1
  fi
fi

mkdir -p "$STATE_DIR"
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  PID=$(cat "$PID_FILE")
else
  PORT=${ALPINE_DESKTOP_CENTER_PORT:-43127}
  while ! "$PYTHON" -c "import socket; s=socket.socket(); s.bind(('127.0.0.1', int('$PORT'))); s.close()" >/dev/null 2>&1; do
    PORT=$((PORT + 1))
  done
  SESSION_TOKEN=$($PYTHON -c 'import secrets; print(secrets.token_urlsafe(32))')
  nohup "$PYTHON" "$APP_DIR/server/local_server.py" --root "$APP_DIR" --host 127.0.0.1 --port "$PORT" --token "$SESSION_TOKEN" >"$LOG_FILE" 2>&1 </dev/null &
  PID=$!
  printf '%s\n' "$PID" > "$PID_FILE"
  printf '%s\n' "$SESSION_TOKEN" > "$STATE_DIR/session.token"
  chmod 0600 "$STATE_DIR/session.token"
fi

PORT=$(grep -o 'http://127\.0\.0\.1:[0-9]*' "$LOG_FILE" | tail -n 1 | sed 's/.*://' || printf '%s' "${PORT:-43127}")
SESSION_TOKEN=$(cat "$STATE_DIR/session.token")
URL="http://127.0.0.1:${PORT}/?session=$SESSION_TOKEN"
HEALTH_URL="http://127.0.0.1:${PORT}/api/health"
check_health() {
  "$PYTHON" - "$HEALTH_URL" "$SESSION_TOKEN" "$PORT" <<'PY'
import json
import sys
from urllib.request import Request, urlopen

url, token, port = sys.argv[1:]
request = Request(
    url,
    headers={"Host": f"127.0.0.1:{port}", "X-ADC-Token": token},
)
try:
    with urlopen(request, timeout=2) as response:
        payload = json.loads(response.read().decode("utf-8"))
        raise SystemExit(0 if response.status < 400 and payload.get("backend") == "validated" else 1)
except Exception:
    raise SystemExit(1)
PY
}
READY=0
for _ in $(seq 1 50); do
  if check_health; then
    READY=1
    break
  fi
  sleep 0.2
done
if [ "$READY" -ne 1 ]; then
  printf '%s\n' 'Alpine Desktop Center local bridge did not become ready. Check .alpine-state/web/server.log.' >&2
  exit 1
fi

open_app_window() {
  BROWSER_PROFILE="$STATE_DIR/browser-profile"
  mkdir -p "$BROWSER_PROFILE"
  if command -v chromium >/dev/null 2>&1; then
    chromium --app="$URL" --user-data-dir="$BROWSER_PROFILE" --class=AlpineDesktopCenter \
      --no-first-run --no-default-browser-check --disable-sync --disable-extensions >/dev/null 2>&1 &
    return 0
  fi
  if command -v chromium-browser >/dev/null 2>&1; then
    chromium-browser --app="$URL" --user-data-dir="$BROWSER_PROFILE" --class=AlpineDesktopCenter \
      --no-first-run --no-default-browser-check --disable-sync --disable-extensions >/dev/null 2>&1 &
    return 0
  fi
  if command -v google-chrome >/dev/null 2>&1; then
    google-chrome --app="$URL" --user-data-dir="$BROWSER_PROFILE" --class=AlpineDesktopCenter \
      --no-first-run --no-default-browser-check --disable-sync --disable-extensions >/dev/null 2>&1 &
    return 0
  fi
  if command -v firefox >/dev/null 2>&1; then
    FIREFOX_PROFILE="$BROWSER_PROFILE/firefox"
    if ! mkdir -p "$FIREFOX_PROFILE" 2>/dev/null || ! chmod 700 "$FIREFOX_PROFILE" 2>/dev/null || [ ! -w "$FIREFOX_PROFILE" ]; then
      FIREFOX_PROFILE=$(mktemp -d "${TMPDIR:-/tmp}/alpine-desktop-center-firefox.XXXXXX")
      chmod 700 "$FIREFOX_PROFILE"
    fi
    # A stale Firefox lock from an interrupted launch can make a valid profile
    # look inaccessible. Only remove lock files when no Firefox process uses it.
    if ! ps -eo args 2>/dev/null | grep -F -- "$FIREFOX_PROFILE" | grep -v grep >/dev/null 2>&1; then
      rm -f "$FIREFOX_PROFILE/.parentlock" "$FIREFOX_PROFILE/parent.lock" "$FIREFOX_PROFILE/lock"
    fi
    firefox --no-remote --profile "$FIREFOX_PROFILE" --new-instance --kiosk "$URL" >/dev/null 2>&1 &
    return 0
  fi
  printf '%s\n' 'No supported app-window browser was found. Install Chromium or Firefox.' >&2
  return 1
}

open_app_window
printf '%s\n' "Alpine Desktop Center is running at $URL"
