#!/bin/sh
set -eu
umask 077
APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHON=${ALPINE_DESKTOP_CENTER_PYTHON:-python3}
STATE_DIR="$APP_DIR/.alpine-state/web"
LOG_FILE="$STATE_DIR/server.log"
PID_FILE="$STATE_DIR/server.pid"

if ! command -v "$PYTHON" >/dev/null 2>&1; then
  TERMINAL=$(command -v konsole || command -v xterm || command -v alacritty || command -v kitty || command -v foot || command -v xfce4-terminal || true)
  if [ -z "$TERMINAL" ]; then
    printf '%s\n' 'Python 3 is required. Install it, then run Alpine Desktop Center again.' >&2
    exit 1
  fi
  exec "$TERMINAL" -e sh -c 'cd "$1/backend" && printf "%s\\n" "Alpine Desktop Center needs Python 3 before it can start." "The backend installer will prepare Python, Ansible, make and doas." "Enter any doas password only in this system terminal."; sh instalar.sh; status=$?; if [ "$status" -ne 0 ]; then printf "\\nSetup failed with exit code %s. Press Enter to close..." "$status"; read -r _; fi; exit "$status"' sh "$APP_DIR"
fi

if [ "${ALPINE_DESKTOP_CENTER_LOCKED:-0}" != 1 ]; then
  if [ -L "$APP_DIR/.alpine-state" ] || [ -L "$STATE_DIR" ]; then
    printf '%s\n' 'Refusing to use a symlinked Alpine Desktop Center state directory.' >&2
    exit 1
  fi
  mkdir -p "$STATE_DIR"
  chmod 0700 "$STATE_DIR"
  exec "$PYTHON" - "$STATE_DIR/launcher.lock" "$APP_DIR/Alpine Desktop Center" <<'PY'
import fcntl
import os
import stat
import sys

lock_path, launcher_path = sys.argv[1:]
flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
fd = os.open(lock_path, flags, 0o600)
info = os.fstat(fd)
if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_nlink != 1:
    raise SystemExit("Refusing an unsafe launcher lock file.")
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    print("Alpine Desktop Center is already starting.")
    raise SystemExit(0)
os.dup2(fd, 9)
os.set_inheritable(9, True)
if fd != 9:
    os.close(fd)
os.environ["ALPINE_DESKTOP_CENTER_LOCKED"] = "1"
os.execv("/bin/sh", ["/bin/sh", launcher_path])
PY
fi

mkdir -p "$STATE_DIR"
chmod 0700 "$STATE_DIR"
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  PID=$(cat "$PID_FILE")
else
  PORT=${ALPINE_DESKTOP_CENTER_PORT:-43127}
  while ! "$PYTHON" -c "import socket; s=socket.socket(); s.bind(('127.0.0.1', int('$PORT'))); s.close()" >/dev/null 2>&1; do
    PORT=$((PORT + 1))
  done
  "$PYTHON" - "$STATE_DIR/session.token" <<'PY'
import os
import secrets
import sys
import tempfile

token_path = sys.argv[1]
fd, temporary_path = tempfile.mkstemp(prefix=".session-token-", dir=os.path.dirname(token_path))
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        stream.write(secrets.token_urlsafe(32) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary_path, token_path)
finally:
    try:
        os.unlink(temporary_path)
    except FileNotFoundError:
        pass
PY
  nohup "$PYTHON" "$APP_DIR/server/local_server.py" --root "$APP_DIR" --host 127.0.0.1 --port "$PORT" --token-file "$STATE_DIR/session.token" 9>&- >"$LOG_FILE" 2>&1 </dev/null &
  PID=$!
  printf '%s\n' "$PID" > "$PID_FILE"
fi

PORT=$(grep -o 'http://127\.0\.0\.1:[0-9]*' "$LOG_FILE" | tail -n 1 | sed 's/.*://' || printf '%s' "${PORT:-43127}")
URL="http://127.0.0.1:${PORT}/"
HEALTH_URL="http://127.0.0.1:${PORT}/api/health"
check_health() {
  "$PYTHON" - "$HEALTH_URL" "$STATE_DIR/session.token" "$PORT" <<'PY'
import json
import sys
from pathlib import Path
from urllib.request import Request, urlopen

url, token_file, port = sys.argv[1:]
token = Path(token_file).read_text(encoding="utf-8").strip()
request = Request(
    url,
    headers={"Host": f"127.0.0.1:{port}", "X-ADC-Token": token},
)
try:
    with urlopen(request, timeout=2) as response:
        payload = json.loads(response.read().decode("utf-8"))
        raise SystemExit(0 if response.status < 400 and payload.get("backend") == "validated" else 1)
except Exception:
    raise SystemExit(1)
PY
}
READY=0
for _ in $(seq 1 50); do
  if check_health; then
    READY=1
    break
  fi
  sleep 0.2
done
if [ "$READY" -ne 1 ]; then
  printf '%s\n' 'Alpine Desktop Center local bridge did not become ready. Check .alpine-state/web/server.log.' >&2
  exit 1
fi
if [ "${ALPINE_DESKTOP_CENTER_LOCKED:-0}" = 1 ]; then
  exec 9>&-
fi

open_app_window() {
  BROWSER_PROFILE="$STATE_DIR/browser-profile"
  mkdir -p "$BROWSER_PROFILE"
  window_ids() {
    xprop -root _NET_CLIENT_LIST 2>/dev/null | sed -n 's/.*# //p' | tr ',' ' '
  }
  set_window_identity() {
    BEFORE_IDS="$1"
    command -v xprop >/dev/null 2>&1 || return 0
    [ -n "${DISPLAY:-}" ] || return 0
    for _ in $(seq 1 50); do
      for WINDOW_ID in $(window_ids); do
        case " $BEFORE_IDS " in *" $WINDOW_ID "*) continue ;; esac
        WINDOW_TITLE=$(xprop -id "$WINDOW_ID" _NET_WM_NAME 2>/dev/null || true)
        case "$WINDOW_TITLE" in
          *Alpine\ Desktop\ Center*)
            xprop -id "$WINDOW_ID" -f _NET_WM_NAME 8u -set _NET_WM_NAME 'Alpine Desktop Center' >/dev/null 2>&1 || true
            xprop -id "$WINDOW_ID" -f WM_NAME 8u -set WM_NAME 'Alpine Desktop Center' >/dev/null 2>&1 || true
            xprop -id "$WINDOW_ID" -f WM_CLASS 8s -set WM_CLASS 'AlpineDesktopCenter\0AlpineDesktopCenter' >/dev/null 2>&1 || true
            return 0
            ;;
        esac
      done
      sleep 0.2
    done
  }
  if command -v chromium >/dev/null 2>&1; then
    if ps -eo args 2>/dev/null | grep -F -- "--user-data-dir=$BROWSER_PROFILE" | grep -v grep >/dev/null 2>&1; then return 0; fi
    BEFORE_IDS=$(window_ids)
    chromium --app="$URL" --user-data-dir="$BROWSER_PROFILE" --class=AlpineDesktopCenter \
      --start-fullscreen --no-first-run --no-default-browser-check --disable-sync --disable-extensions >/dev/null 2>&1 &
    set_window_identity "$BEFORE_IDS" &
    sleep 0.5
    return 0
  fi
  if command -v chromium-browser >/dev/null 2>&1; then
    if ps -eo args 2>/dev/null | grep -F -- "--user-data-dir=$BROWSER_PROFILE" | grep -v grep >/dev/null 2>&1; then return 0; fi
    BEFORE_IDS=$(window_ids)
    chromium-browser --app="$URL" --user-data-dir="$BROWSER_PROFILE" --class=AlpineDesktopCenter \
      --start-fullscreen --no-first-run --no-default-browser-check --disable-sync --disable-extensions >/dev/null 2>&1 &
    set_window_identity "$BEFORE_IDS" &
    sleep 0.5
    return 0
  fi
  if command -v google-chrome >/dev/null 2>&1; then
    if ps -eo args 2>/dev/null | grep -F -- "--user-data-dir=$BROWSER_PROFILE" | grep -v grep >/dev/null 2>&1; then return 0; fi
    BEFORE_IDS=$(window_ids)
    google-chrome --app="$URL" --user-data-dir="$BROWSER_PROFILE" --class=AlpineDesktopCenter \
      --start-fullscreen --no-first-run --no-default-browser-check --disable-sync --disable-extensions >/dev/null 2>&1 &
    set_window_identity "$BEFORE_IDS" &
    sleep 0.5
    return 0
  fi
  if command -v firefox >/dev/null 2>&1; then
    FIREFOX_PROFILE="$BROWSER_PROFILE/firefox"
    if ! mkdir -p "$FIREFOX_PROFILE" 2>/dev/null || ! chmod 700 "$FIREFOX_PROFILE" 2>/dev/null || [ ! -w "$FIREFOX_PROFILE" ]; then
      FIREFOX_PROFILE=$(mktemp -d "${TMPDIR:-/tmp}/alpine-desktop-center-firefox.XXXXXX")
      chmod 700 "$FIREFOX_PROFILE"
    fi
    # A stale Firefox lock from an interrupted launch can make a valid profile
    # look inaccessible. Only remove lock files when no Firefox process uses it.
    if ! ps -eo args 2>/dev/null | grep -F -- "$FIREFOX_PROFILE" | grep -v grep >/dev/null 2>&1; then
      rm -f "$FIREFOX_PROFILE/.parentlock" "$FIREFOX_PROFILE/parent.lock" "$FIREFOX_PROFILE/lock"
    else
      return 0
    fi
    BEFORE_IDS=$(window_ids)
    firefox --no-remote --profile "$FIREFOX_PROFILE" --new-instance --name=AlpineDesktopCenter --kiosk "$URL" >/dev/null 2>&1 &
    set_window_identity "$BEFORE_IDS" &
    sleep 0.5
    return 0
  fi
  printf '%s\n' 'No supported app-window browser was found. Install Chromium or Firefox.' >&2
  return 1
}

open_app_window
printf '%s\n' "Alpine Desktop Center is running at $URL"
